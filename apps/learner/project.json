{
  "name": "learner",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/learner/src",
  "tags": ["scope:learner", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/learner",
        "index": "apps/learner/src/index.html",
        "browser": "apps/learner/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/learner/tsconfig.app.json",
        "assets": [
          { "glob": "**/*", "input": "apps/learner/public" },
          { "glob": "**/*", "input": "libs/ui/src/assets/forge", "output": "assets/forge" },
          { "glob": "*.mp3", "input": "libs/sfx/assets", "output": "assets/sfx" }
        ],
        "styles": ["libs/ui/src/styles/forge/index.css", "apps/learner/src/styles.scss"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "10kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/learner/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/learner/src/environments/environment.ts",
              "with": "apps/learner/src/environments/environment.development.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "defaultConfiguration": "development",
      "continuous": true,
      "configurations": {
        "production": {
          "buildTarget": "learner:build:production"
        },
        "development": {
          "buildTarget": "learner:build:development"
        }
      },
      "readyWhen": {
        "signal": true
      }
    }
  }
}

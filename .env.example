# Soteria FORGE — example environment. Copy to .env and fill.
# NEVER commit real values. Server-side secrets live in the Railway service variables
# (see backend/.env.example), not here.

# --- Frontend build (Railway service variables or Docker build args; see scripts/forge-env.mjs) ---
# The only required variable: the Forge API (Django on Railway).
FORGE_API_BASE_URL=https://api.soteriaforge.com
# Optional: platform apex used for subdomain tenant resolution.
FORGE_ROOT_DOMAIN=soteriaforge.com

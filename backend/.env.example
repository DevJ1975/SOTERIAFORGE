# Copy to .env for local runs:  uv run --env-file .env python manage.py runserver
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://forge:forge@localhost:5433/forge
FORGE_ROOT_DOMAIN=soteriaforge.com
# Firebase (identity only). Locally: gcloud ADC or a service-account JSON string.
FIREBASE_PROJECT_ID=soteria-forge-dev
FIREBASE_CREDENTIALS_JSON=
SENTRY_DSN=

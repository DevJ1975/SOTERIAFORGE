# Copy to .env for local runs:  uv run --env-file .env python manage.py runserver
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://forge:forge@localhost:5433/forge
# Runtime role bound by row-level security (apps/tenants/dbroles.py). With a
# password set, the server connects as this role; DB_USE_OWNER=1 overrides.
DB_APP_USER=forge_app
DB_APP_PASSWORD=
FORGE_ROOT_DOMAIN=soteriaforge.com
# Firebase (identity only). Locally: gcloud ADC or a service-account JSON string.
FIREBASE_PROJECT_ID=soteria-forge-dev
FIREBASE_CREDENTIALS_JSON=
SENTRY_DSN=
# Local LiveKit uses backend/docker-compose.yml's opt-in media profile.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Native macOS Ollama at 127.0.0.1:11434; enable only on the inference Mac.
COACH_ENABLED=false

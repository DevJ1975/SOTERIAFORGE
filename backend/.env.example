# Copy to .env for local runs:  uv run --env-file .env python manage.py runserver
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://forge:forge@localhost:5433/forge
# Runtime role bound by row-level security (apps/tenants/dbroles.py). With a
# password set, the server connects as this role; DB_USE_OWNER=1 overrides.
DB_APP_USER=forge_app
DB_APP_PASSWORD=
FORGE_ROOT_DOMAIN=soteriaforge.com
SENTRY_DSN=
# Local LiveKit uses backend/docker-compose.yml's opt-in media profile.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Native macOS Ollama at 127.0.0.1:11434; enable only on the inference Mac.
COACH_ENABLED=false

# SCORM import and playback (off until storage + isolated content service are ready).
STANDARDS_ENABLED=false
STANDARDS_CONTENT_ORIGIN=
# Exact learner origins, comma-separated. Never include the content origin.
STANDARDS_APP_ORIGINS=
# Private Railway Bucket S3 variables; map the bucket's generated credentials here.
STANDARDS_S3_ENDPOINT=
STANDARDS_S3_BUCKET=
STANDARDS_S3_ACCESS_KEY=
STANDARDS_S3_SECRET_KEY=
STANDARDS_S3_REGION=auto
# DEBUG only; absolute directory for a local development pilot, never production.
STANDARDS_LOCAL_ROOT=
# Install backend/runtime with npm ci; default runtime path needs no override.
SCORM_RUNTIME_PATH=

# External LRS, xAPI 1.0.3. Never put these in Angular environments.
XAPI_RECORDING_ENABLED=false
XAPI_ACTIVITY_BASE=https://soteriaforge.com/xapi
XAPI_LRS_ENDPOINT=
# Complete Authorization header (Basic ... or Bearer ...), secret service variable.
XAPI_LRS_AUTH=

# --- Sign-in (Django-issued tokens; see apps/accounts/auth_views.py) ---
# Access/refresh lifetimes in seconds (defaults: 15 minutes / 14 days).
# AUTH_ACCESS_TTL_SECONDS=900
# AUTH_REFRESH_TTL_SECONDS=1209600
# "Lax" when the app and API share a site (*.soteriaforge.com); "None" for a
# frontend on another site such as *.vercel.app previews.
# AUTH_COOKIE_SAMESITE=Lax
# Base URL for password-reset/invite links (default: the member's tenant host).
# AUTH_LINK_BASE_URL=https://acme.soteriaforge.com

# --- Email (password reset and invites). Console backend prints emails locally. ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Soteria Forge <no-reply@soteriaforge.com>

# --- Uploaded lesson files (apps/assets) ---
# Uploads (POST /api/assets, max 100 MB) and their signed read URLs reuse the private
# bucket configured above (STANDARDS_S3_ENDPOINT/BUCKET/ACCESS_KEY/SECRET_KEY) under the
# "assets/" prefix, so no extra variables are needed. The bucket must stay private.
# In DEBUG, STANDARDS_LOCAL_ROOT stores them on disk and Django serves them from
# /api/assets/<id>/content?sig=... instead of an S3 URL.

# --- MCP server for Claude / ChatGPT (apps/mcp, docs/forge-mcp.md) ---
# OAuth issuer/resource origin; defaults to https://$RAILWAY_PUBLIC_DOMAIN, else localhost.
# FORGE_PUBLIC_URL=http://localhost:8000
# https hosts OAuth clients may redirect to (loopback http is always allowed).
# MCP_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,chat.openai.com
# Hosts forge_import_media may download generated files from. Exact host, or
# ".example.com" for its subdomains. Empty = media import is off.
# MCP_MEDIA_IMPORT_HOSTS=api.elevenlabs.io
# Platform-admin tools. Fine-grained GitHub token: this repo, Contents + Pull requests only.
# RAILWAY_API_TOKEN=
# GITHUB_TOKEN=

# --- Signed badge credentials (apps/gamification/credentials.py, docs/open-badges.md) ---
# Ed25519 private key (PEM). Generate with: manage.py generate_badge_key
# Newlines may be written as \n. Without it, awards are recorded but not signed.
# BADGE_SIGNING_KEY=

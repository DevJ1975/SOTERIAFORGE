{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Soteria Forge",
  "version": "1.0.0",
  "color": {
    "brand": {
      "charcoal": { "$value": "#1B1E23", "$type": "color", "$description": "Rail, dark surfaces, learner chat bubbles" },
      "charcoal-2": { "$value": "#242830", "$type": "color" },
      "charcoal-3": { "$value": "#2E333C", "$type": "color", "$description": "Active rail tile" },
      "ember": { "$value": "#DC481B", "$type": "color", "$description": "Primary action, active state, progress" },
      "ember-dark": { "$value": "#AE3A14", "$type": "color" },
      "ember-soft": { "$value": "#FFF1EB", "$type": "color" },
      "ember-on-soft": { "$value": "#B33A12", "$type": "color" },
      "flame": { "$value": "#F69A3C", "$type": "color" },
      "gold": { "$value": "#FFC774", "$type": "color" },
      "flame-cream": { "$value": "#FFE6B0", "$type": "color" }
    },
    "neutral": {
      "cream": { "$value": "#F6F3EC", "$type": "color", "$description": "App canvas" },
      "surface": { "$value": "#FFFFFF", "$type": "color" },
      "line": { "$value": "#E6E1D8", "$type": "color" },
      "muted-bg": { "$value": "#F1EEE7", "$type": "color" },
      "ink": { "$value": "#1B1E23", "$type": "color" },
      "ink-2": { "$value": "#4B5563", "$type": "color" },
      "muted": { "$value": "#6B7280", "$type": "color" },
      "placeholder": { "$value": "#9AA3AF", "$type": "color" }
    },
    "status": {
      "success": { "$value": "#1E9E6A", "$type": "color" },
      "success-soft": { "$value": "#E6F6EF", "$type": "color" },
      "success-ink": { "$value": "#0F5E3C", "$type": "color" },
      "danger": { "$value": "#C0392B", "$type": "color" },
      "danger-soft": { "$value": "#FFF5F5", "$type": "color" },
      "warning": { "$value": "#F2A900", "$type": "color" }
    },
    "engage": {
      "bg": { "$value": "#16181C", "$type": "color" },
      "pane": { "$value": "#1F2228", "$type": "color" },
      "line": { "$value": "#2B2F36", "$type": "color" },
      "inset": { "$value": "#15171B", "$type": "color" },
      "text": { "$value": "#C9CED6", "$type": "color" }
    },
    "sfg": {
      "navy": { "$value": "#0B3D5C", "$type": "color" },
      "navy-soft": { "$value": "#E6EEF5", "$type": "color" },
      "teal": { "$value": "#128C9E", "$type": "color" },
      "teal-light": { "$value": "#5CC6D0", "$type": "color" },
      "gold": { "$value": "#F2A900", "$type": "color" }
    }
  },
  "font": {
    "family": { "$value": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif", "$type": "fontFamily" },
    "size": {
      "xs": { "$value": "12px", "$type": "dimension" },
      "sm": { "$value": "13px", "$type": "dimension" },
      "base": { "$value": "15px", "$type": "dimension" },
      "md": { "$value": "16px", "$type": "dimension" },
      "lg": { "$value": "20px", "$type": "dimension" },
      "xl": { "$value": "30px", "$type": "dimension" },
      "display": { "$value": "88px", "$type": "dimension" }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "black": 800 }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px" },
  "radius": { "sm": "8px", "md": "12px", "lg": "14px", "xl": "16px", "full": "999px" },
  "shadow": {
    "card": "0 1px 2px rgba(27,30,35,0.04)",
    "panel": "-12px 0 40px rgba(27,30,35,0.12)",
    "badge": "0 8px 24px rgba(220,72,27,0.35)"
  },
  "layout": { "rail-width": "88px", "topbar-height": "64px", "panel-width": "640px", "control-height": "44px" },
  "motion": { "ease": "cubic-bezier(0.2,0.7,0.2,1)", "fast": "150ms", "base": "300ms", "slow": "800ms" }
}
